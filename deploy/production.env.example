# Production settings for Touchline Takes. Copy to .env.production (git-ignored)
# and fill in. The app refuses to start until `python -m touchline_takes.preflight`
# reports no errors.

TOUCHLINE_ENV=production
SITE_URL=https://touchlinetakes.com

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# At least 12 characters. Admin user name is "admin".
ADMIN_PASSWORD=

# Sources. Check each feed's terms of use before publishing summaries of it.
RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss,https://www.skysports.com/rss/12040
FOOTBALL_DATA_API_KEY=

# Results data for the Analyst and the stats lines. On first start the container
# downloads these Football-Data.co.uk seasons into the volume if none are there.
RESULTS_SEASONS=2425 2526 2627
RESULTS_LEAGUE=E0

# Writer / classifier / QA model (offline templates work, but read robotically).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MAX_CALLS_PER_RUN=40
FACTCHECK_VERIFIER=rules

# Editorial
AUTO_PUBLISH=false
MAX_ARTICLES_PER_RUN=6
SCHEDULE_MINUTES=30

# Photo tagger: keep off until it is retrained on real photos.
PHOTO_TAGGER=false

# Abuse protection
ASK_RATE_LIMIT=10/minute
ADMIN_AUTH_RATE_LIMIT=20/hour
