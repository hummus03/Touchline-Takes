<?xml version="1.0" ?>
<mxfile host="app.diagrams.net">
  <diagram id="touchline-detailed" name="Pipeline (detailed)">
    <mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v1" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;Touchline &lt;font color=&quot;#0b6e3a&quot;&gt;Takes&lt;/font&gt;: how the newsroom works&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#56655b&quot;&gt;Eight agents run in order. Only the Writer uses AI (Claude); a human approves every article.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1350" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="v2" value="DATA SOURCES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa79f;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#56655b;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="1390" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;RSS news feeds&lt;/b&gt;&lt;br&gt;&lt;i&gt;BBC Sport · The Guardian · Sky Sports&lt;/i&gt;&lt;br&gt;Each story&amp;#x27;s headline, summary, link and date" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v4" value="&lt;b&gt;football-data.co.uk&lt;/b&gt;&lt;br&gt;&lt;i&gt;The past&lt;/i&gt;&lt;br&gt;Premier League results and Bet365 odds, as CSV files" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v5" value="&lt;b&gt;football-data.org&lt;/b&gt;&lt;br&gt;&lt;i&gt;What&amp;#x27;s next&lt;/i&gt;&lt;br&gt;Upcoming fixtures, through an API with a key" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v6" value="GATHER" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa79f;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#56655b;" vertex="1" parent="1">
          <mxGeometry x="20" y="270" width="1390" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="v7" value="WRITE AND CHECK" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa79f;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#56655b;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="1390" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b style=&quot;font-size:15px&quot;&gt;1 · Ingest&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Wire reporter&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Downloads the feeds, cleans the text, drops repeats (same link, or 80%+ similar words) and skips non-news: live blogs, videos, newsletters, other sports.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Python requests · feedparser · TF-IDF similarity · SQLite&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b style=&quot;font-size:15px&quot;&gt;2 · Classifier&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Section editor&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Labels each story&amp;#x27;s league, clubs and topic. A match report only if the headline shows a score or a result word.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Keyword rules (regex) · teams.json club list&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="300" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b style=&quot;font-size:15px&quot;&gt;3 · Research (RAG)&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Researcher&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Keeps a searchable library of past stories and finds related coverage that names the same clubs in its headline.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;TF-IDF embeddings · Chroma vector database · retriever&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="300" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b style=&quot;font-size:15px&quot;&gt;4 · Analyst&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#d79b00&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;MACHINE LEARNING&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Stats person&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Gives each club&amp;#x27;s recent form and home / draw / away probabilities for upcoming fixtures. Tested on later matches it never saw.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;scikit-learn logistic regression · pandas · Elo + form features&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="300" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="&lt;b style=&quot;font-size:15px&quot;&gt;5 · Writer&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#9673a6&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;GENERATIVE AI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Journalist&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Builds a numbered evidence pack (S1 stories, ST1 stats, M1 predictions). Claude writes 220–400 words; every fact cites an item. Templates if Claude fails.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Claude Haiku 5.5 (Anthropic API) · prompt + evidence pack&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="&lt;b style=&quot;font-size:15px&quot;&gt;6 · Fact-checker&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;&amp;quot;Is it true?&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Checks each claim against its cited source: names and numbers, who won, whose stat, number + unit. Missing source: cut the line. Wrong source: rewrite.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Python rules (regex) · no AI&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="610" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="&lt;b style=&quot;font-size:15px&quot;&gt;7 · Editor&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;&amp;quot;Is it good?&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Length 90–450 words, headline names the club, a real opinion and verdict line, 3+ sourced facts, no 10 words copied from a source.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;Python rules · no AI&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="610" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a8" value="&lt;b style=&quot;font-size:15px&quot;&gt;8 · Publisher&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#6c8ebf&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;CODE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;i&gt;Production desk&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;WHAT IT DOES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Final &amp;quot;no claim without a source&amp;quot; check, then opens one GitHub pull request per article, with a Post to X link.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#56655b&quot;&gt;TOOLS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;git · GitHub API&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1090" y="610" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a5" target="a6">
          <mxGeometry relative="1" as="geometry"/>
