        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a6" target="a7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a7" target="a8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="v3" target="a1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="v4" target="a4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="v5" target="a4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e25" value="evidence pack (S1 · ST1 · M1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1240" y="555"/>
              <mxPoint x="190" y="555"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e26" value="rewrite (max 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="a6" target="a5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="540" y="840"/>
              <mxPoint x="190" y="840"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="a7" target="a5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="890" y="840"/>
              <mxPoint x="190" y="840"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="v28" value="&lt;b&gt;↺ Rewrite loop:&lt;/b&gt; the Fact-checker or Editor can send a draft back to the Writer at most 2 times; after that it is rejected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=none;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="855" width="1350" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="v29" value="PUBLISH" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9aa79f;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#56655b;" vertex="1" parent="1">
          <mxGeometry x="20" y="950" width="1390" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="v30" value="&lt;b&gt;GitHub pull request&lt;/b&gt;&lt;br&gt;The article, its sources and claim count, ready to review" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v31" value="&lt;b&gt;You merge&lt;/b&gt;&lt;br&gt;Editor-in-chief: merge publishes, close rejects" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="980" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v32" value="&lt;b&gt;Live site&lt;/b&gt;&lt;br&gt;GitHub Actions builds the pages (Flask templates); GitHub Pages serves touchlinetakes.com" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="980" width="430" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="a8" target="v30">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1240" y="930"/>
              <mxPoint x="255" y="930"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="v30" target="v31">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e35" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#0b6e3a;fontColor=#0b6e3a;fontStyle=1;" edge="1" parent="1" source="v31" target="v32">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="v36" value="WHAT HOLDS IT TOGETHER" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1d2a22;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#56655b;" vertex="1" parent="1">
          <mxGeometry x="20" y="1120" width="1390" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="v37" value="&lt;font color=&quot;#f2c14e&quot; style=&quot;font-size:15px&quot;&gt;&lt;b&gt;LangGraph&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Runs the agents in order and manages the rewrite loop (max 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d2a22;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1150" width="430" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="v38" value="&lt;font color=&quot;#f2c14e&quot; style=&quot;font-size:15px&quot;&gt;&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Runs the whole newsroom twice a day, for free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1d2a22;strokeColor=none;fontColor=#ffffff;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1150" width="430" height="70" as="geometry"/>
