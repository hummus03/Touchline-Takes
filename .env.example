# Copy to .env (git-ignored) and fill in. Nothing here is required:
# with no keys the newsroom runs fully offline on bundled sample data.
# For production use deploy/production.env.example instead (see DEPLOY.md).

# --- Environment ----------------------------------------------------------------
# development (default) | production (strict preflight; sample data is never used)
TOUCHLINE_ENV=development
# Sample feeds/stats/fixtures/photos fallback. Defaults to true in development and
# false in production; never set it to true on the public site.
ALLOW_SAMPLE_DATA=

# --- Data sources -----------------------------------------------------------
# Comma-separated RSS feeds. If none can be fetched, bundled samples are used.
RSS_FEEDS=https://feeds.bbci.co.uk/sport/football/rss.xml,https://www.theguardian.com/football/rss,https://www.skysports.com/rss/12040
# Force offline mode (skip all network fetches, use bundled samples).
TOUCHLINE_OFFLINE=false
# Optional: football-data.org API token for real upcoming fixtures.
FOOTBALL_DATA_API_KEY=

# --- LLM provider -----------------------------------------------------------
# offline (templates, default) | anthropic | openai (any OpenAI-compatible API, e.g. Ollama)
LLM_PROVIDER=offline
# Blank = claude-opus-5-5. claude-haiku-5-5 costs ~1/40th as much (the workflow's default).
LLM_MODEL=
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Hard cap on (uncached) LLM calls per pipeline run.
LLM_MAX_CALLS_PER_RUN=40
LLM_CACHE=true

# --- Embeddings / RAG -------------------------------------------------------
# tfidf (offline, default) | openai
EMBEDDINGS_PROVIDER=tfidf
EMBEDDINGS_MODEL=text-embedding-3-small
# chroma (persistent) | memory
VECTOR_STORE=chroma

# --- Classifier -------------------------------------------------------------
# local (lexicon, default) | llm (uses the LLM provider above, falls back to local)
CLASSIFIER_PROVIDER=local

# --- Fact-checking -----------------------------------------------------------
# rules (deterministic token + relation checks, default) | llm (rules, then an LLM
# entailment check of the claims that pass; one batched call per draft)
FACTCHECK_VERIFIER=rules

# --- Photo tagger ---------------------------------------------------------------
# Tags the photo attached to each story (VGG16 transfer learning). Train it first:
# python scripts/train_photo_tagger.py   (skipped quietly until a model exists)
PHOTO_TAGGER=true
PHOTO_MODEL_DIR=data/models/photo_tagger
PHOTO_MAX_PER_RUN=20
KERAS_BACKEND=jax

# --- Orchestration -------------------------------------------------------------
# langgraph (StateGraph with SQLite checkpoints; runs pause at human review) | sequential
ORCHESTRATOR=langgraph
CHECKPOINT_PATH=data/checkpoints.db

# --- Newsroom behaviour -----------------------------------------------------
AUTO_PUBLISH=false
MAX_REVISIONS=2
MAX_ARTICLES_PER_RUN=6
DEDUPE_THRESHOLD=0.8

# --- Web --------------------------------------------------------------------
ASK_RATE_LIMIT=10/minute
ADMIN_AUTH_RATE_LIMIT=20/hour
# Number of reverse proxies in front of the app (Caddy, Fly, Render: 1)
PROXY_HOPS=0
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me
SITE_URL=https://touchlinetakes.com
# Shown on the About, Privacy and Terms pages.
CONTACT_EMAIL=touchlinetakes101@gmail.com
DATABASE_PATH=data/touchline_takes.db
